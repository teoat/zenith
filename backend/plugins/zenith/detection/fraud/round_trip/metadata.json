{
  "name": "round_trip",
  "version": "1.0.0",
  "namespace": "378x492/detection/fraud/round_trip",
  "description": "Detects round-trip transactions (A-B-C-A)",
  "author": "378x492 Team",
  "entry_point": "plugin.py:RoundTripPlugin",
  "dependencies": {},
  "capabilities": [
    "fraud_detection"
  ],
  "config_schema": {
    "max_path_length": {
      "type": "integer",
      "default": 5
    },
    "time_window_hours": {
      "type": "number",
      "default": 24.0
    },
    "amount_tolerance": {
      "type": "number",
      "default": 0.1
    }
  }
}