# Railway API Gateway URL
# After deploying Railway services, update these URLs
RAILWAY_API_GATEWAY_URL=https://zenith-api-gateway-production.up.railway.app
RAILWAY_AI_ML_URL=https://zenith-ai-ml-production.up.railway.app
RAILWAY_FRAUD_INTEL_URL=https://zenith-fraud-intel-production.up.railway.app
RAILWAY_WORKFLOW_REGULATORY_URL=https://zenith-workflow-regulatory-production.up.railway.app

# Vercel KV (optional - will use in-memory cache if not set)
KV_REST_API_URL=your-kv-rest-api-url
KV_REST_API_TOKEN=your-kv-rest-api-token
KV_URL=your-kv-url

# Rate limiting
RATE_LIMIT_MAX=100
CACHE_TTL=300

# Retry configuration
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_MS=500
