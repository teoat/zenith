{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "error-prevention": "node ../scripts/automated_error_prevention.js",
    "link-check": "node ../scripts/link_checker.js",
    "security-scan": "node ../scripts/automated_error_prevention.js --security-only",
