# AntiGravity Fraud Detection System - Environment Variables
# Copy this file to .env and fill in the values

# ===== FRONTEND =====
# Mapbox token for the Threat Map visualization
# Get one free at https://www.mapbox.com/
VITE_MAPBOX_TOKEN=

# API URL (defaults to localhost:8000)
VITE_API_URL=http://localhost:8000

# WebSocket URL for live updates
VITE_WS_URL=ws://localhost:8000

# ===== BACKEND (if applicable) =====
# Database connection (SQLCipher for Electron, PostgreSQL for web)
# DATABASE_URL=sqlite:///./data/fraud_detection.db

# JWT Secret for authentication
# JWT_SECRET=your-secret-key-here

# ===== OPTIONAL =====
# Enable debug mode
# DEBUG=true

# Log level
# LOG_LEVEL=info
