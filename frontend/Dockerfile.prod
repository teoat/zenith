# Stage 1: Build the React Application
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies (cached if package.json hasn't changed)
COPY package.json package-lock.json ./
RUN npm ci

# Copy source code and build
COPY . .
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Install security headers module if needed (standard nginx:alpine usually suffices for basic config)
# RUN apk add --no-cache nginx-mod-http-headers-more

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# validation: ensure build artifacts exist
RUN test -f /usr/share/nginx/html/index.html || (echo "Build failed: index.html not found" && exit 1)

# Copy custom Nginx configuration
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
