{
  "branches": [
    "main",
    "develop"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "package.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "release/mac/378x492 Fraud Detection-*.dmg",
            "label": "macOS DMG"
          },
          {
            "path": "release/mac-arm64/378x492 Fraud Detection-*.dmg",
            "label": "macOS ARM64 DMG"
          },
          {
            "path": "release/win/378x492 Fraud Detection Setup *.exe",
            "label": "Windows Installer"
          },
          {
            "path": "release/linux/378x492 Fraud Detection-*.AppImage",
            "label": "Linux AppImage"
          }
        ]
      }
    ]
  ]
}