    def test_password_strength_validation(self, auth_svc):
        """Test password strength validation"""
        # Weak passwords should be flagged
        weak_passwords = ["short", "nouppercase123", "NOLOWERCASE123", "NoNumbers", "NoSpecial123"]

        for password in weak_passwords:
            result = auth_svc.validate_password_strength(password)
            assert len(result['issues']) > 0

        # Strong password should pass
        strong_password = os.getenv("TEST_STRONG_PASSWORD", "StrongPass123!")
        result = auth_svc.validate_password_strength(strong_password)
        assert len(result['issues']) == 0
