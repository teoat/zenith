import os
import sys

sys.path.insert(0, os.path.abspath("."))

from unittest.mock import Mock, patch

# tests/unit/test_auth.py
import pytest

from backend.app.services.infrastructure.auth_service import AuthService
from core.database import UserRole


class TestAuthService:
    """Unit tests for AuthService"""

    @pytest.fixture
    def auth_svc(self):
        """Create a fresh auth service instance"""
        return AuthService()

    def test_password_hashing(self, auth_svc):
        """Test password hashing and verification"""
        password = os.getenv("TEST_PASSWORD", "test_password_123")

        # Hash password
        hashed = auth_svc.hash_password(password)
        assert hashed != password
        assert hashed.startswith("$pbkdf2-sha256")

        # Verify correct password
        assert auth_svc.verify_password(password, hashed)

        # Verify incorrect password
        assert not auth_svc.verify_password("wrong_password", hashed)

    @pytest.mark.asyncio
    async def test_create_access_token(self, auth_svc):
        """Test JWT access token creation"""
        data = {"sub": "user123", "username": "testuser"}

        token = await auth_svc.create_access_token(data)

        # Decode and verify token
        decoded = auth_svc.decode_token(token)

        assert decoded["sub"] == "user123"
        assert decoded["username"] == "testuser"
        assert decoded["type"] == "access"
        assert "exp" in decoded
        assert "iat" in decoded
        assert decoded["iss"] == "zenith"

    def test_create_refresh_token(self, auth_svc):
        """Test JWT refresh token creation"""
        user_id = "user123"

        token = auth_svc.create_refresh_token(user_id)

        # Verify token is a string and not empty
        assert isinstance(token, str)
        assert len(token) > 0

        # Verify token contains expected parts (header.payload.signature)
        parts = token.split('.')
        assert len(parts) == 3

        # Note: Refresh tokens are not decoded in normal flow to avoid session overhead
        # They are only decoded when used to generate new access tokens

    def test_decode_invalid_token(self, auth_svc):
        """Test decoding invalid tokens"""
        with pytest.raises(Exception):
            auth_svc.decode_token("invalid_token")

        with pytest.raises(Exception):
            auth_svc.decode_token("")

        async def test_authenticate_user_failure(self, mock_verify, mock_db, auth_svc):
        """Test failed user authentication"""
        # Mock user
        mock_user = Mock()
        mock_user.password_hash = "hashed_password"
        mock_user.id = "user123"
        mock_user.is_active = True
        mock_db.get_user_by_username.return_value = mock_user
        mock_verify.return_value = False
        # Non-existent user
        result = await auth_svc.authenticate_user("nonexistent", "password", None)
        assert result is None

    @patch("app.services.infrastructure.storage.database_service.db_service")
    @pytest.mark.asyncio
@pytest.mark.skip("get_current_user is FastAPI dependency")
        async def test_get_current_user_success(self, mock_db, auth_svc):
        """Test getting current authenticated user"""
        # Mock user
        mock_user = Mock()
        mock_user.id = "user123"
        mock_user.is_active = True
        mock_db.get_user.return_value = mock_user

        # Mock token
        token_data = {"sub": "user123"}
        token = await auth_svc.create_access_token(token_data)

        from fastapi.security import HTTPAuthorizationCredentials

        credentials = HTTPAuthorizationCredentials(scheme="Bearer", credentials=token)

        result = await auth_svc.get_current_user(None, credentials)

        assert result == mock_user
        mock_db.get_user.assert_called_once_with("user123")

    @patch("backend.app.services.infrastructure.auth_service.db_service")
    @pytest.mark.asyncio
@pytest.mark.skip("get_current_user is FastAPI dependency")
        async def test_get_current_user_inactive(self, mock_db, auth_svc):
        """Test getting inactive user fails"""
        # Mock inactive user
        mock_user = Mock()
        mock_user.is_active = False
        mock_db.get_user.return_value = mock_user

        token_data = {"sub": "user123"}
        token = await auth_svc.create_access_token(token_data)

        from fastapi.security import HTTPAuthorizationCredentials

        credentials = HTTPAuthorizationCredentials(scheme="Bearer", credentials=token)

        with pytest.raises(Exception):  # Should raise HTTPException
            await auth_svc.get_current_user(None, credentials)

