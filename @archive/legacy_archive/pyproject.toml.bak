[tool.black]
line-length = 120
target-version = ['py312']
include = '\.pyi?$'
extend-exclude = '''
/(
  # directories
  \.eggs
  | \.git
  | \.hg
  | \.mypy_cache
  | \.tox
  | \.venv
  | _build
  | buck-out
  | build
  | dist
  | node_modules
  | \.venv
  | venv
)/
'''

[tool.isort]
profile = "black"
multi_line_output = 3
line_length = 120
include_trailing_comma = true
force_grid_wrap = 0
use_parentheses = true
ensure_newline_before_comments = true
known_first_party = ["backend", "core", "services", "scripts"]
skip = ["__init__.py", ".venv", "node_modules", ".git"]

[tool.mypy]
python_version = "3.12"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = false
disallow_incomplete_defs = false
check_untyped_defs = true
no_implicit_optional = true
warn_redundant_casts = true
warn_unused_ignores = true
warn_no_return = true
warn_unreachable = true
strict_optional = true
show_error_codes = true
show_column_numbers = true
show_error_context = true
color_output = true
error_summary = true
incremental = true
cache_dir = ".mypy_cache"
exclude = [
    '\.git',
    '\.venv',
    'venv',
    'node_modules',
    'dist',
    'build',
    'migrations',
    'alembic',
    'frontend',
    'infrastructure',
    'monitoring',
]

[tool.mypy.plugins.pydantic]
init_forbid_extra = true
init_typed = true
warn_required_dynamic_aliases = true

[tool.ruff]
line-length = 120
target-version = "py312"
select = [
    "E",
    "F",
    "W",
    "C",
    "N",
    "UP",
    "B",
    "A",
    "C4",
    "DTZ",
    "T10",
    "EM",
    "ISC",
    "ICN",
    "G",
    "INP",
    "PIE",
    "PYI",
    "PT",
    "Q",
    "RSE",
    "RET",
    "SLF",
    "S",
    "SIM",
    "TID",
    "TCH",
    "ARG",
    "PTH",
    "ERA",
    "PD",
    "PGH",
    "PL",
    "TRY",
    "FLY",
    "NPY",
    "RUF",
]
ignore = [
    "E501",  # line too long (handled by black)
    "E203",  # whitespace before ':' (conflicts with black)
    "PLR0913",  # too many arguments (sometimes necessary)
    "PLR0912",  # too many branches (sometimes necessary)
    "PLR0915",  # too many statements (sometimes necessary)
    "TRY003",  # long exception messages
    "ARG001",  # unused function argument (handled by other tools)
    "ARG002",  # unused function argument (handled by other tools)
]
exclude = [
    ".git",
    "__pycache__",
    ".venv",
    "venv",
    "node_modules",
    "dist",
    "build",
    "*.egg-info",
    ".tox",
    ".coverage",
    "htmlcov",
    ".mypy_cache",
    ".dmypy.json",
    "dmypy.json",
    "migrations",
    "alembic",
    "frontend",
    "infrastructure",
    "monitoring",
]

[tool.ruff.per-file-ignores]
"test_*.py" = ["S101", "ARG", "PLR2004"]
"*_test.py" = ["S101", "ARG", "PLR2004"]
"tests/**/*.py" = ["S101", "ARG", "PLR2004"]
"conftest.py" = ["S101", "F401", "F841"]
"__init__.py" = ["F401"]
"settings.py" = ["F401", "F841"]
"**/migrations/*.py" = ["F401", "E501"]

[tool.pytest.ini_options]
testpaths = ["tests", "backend/tests"]
python_files = ["test_*.py", "*_test.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]
addopts = [
    "--strict-markers",
    "--strict-config",
    "--showlocals",
    "--tb=short",
    "--cov-report=term-missing",
    "--cov-report=html",
    "--no-cov-on-fail",
    "-n", "auto",
]
markers = [
    "unit: Unit tests",
    "integration: Integration tests",
    "e2e: End-to-end tests",
    "slow: Slow running tests",
    "skip: Skip test",
]
filterwarnings = [
    "ignore::DeprecationWarning",
    "ignore::PendingDeprecationWarning",
]

[tool.coverage.run]
source = ["backend", "app", "core"]
omit = [
    "*/tests/*",
    "*/test_*.py",
    "*/migrations/*",
    "*/alembic/*",
    "*/__pycache__/*",
    "*/site-packages/*",
]

[tool.coverage.report]
exclude_lines = [
    "pragma: no cover",
    "def __repr__",
    "raise AssertionError",
    "raise NotImplementedError",
    "if __name__ == .__main__.:",
    "if TYPE_CHECKING:",
    "if typing.TYPE_CHECKING:",
    "@abstractmethod",
    "class .*\\bProtocol\\b:",
    "@(abc\\.)?abstractmethod",
]
fail_under = 80
show_missing = true

[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "zenith"
version = "1.0.0"
description = "Advanced fraud detection platform with AI/ML capabilities"
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
    # Core web framework and API
    "fastapi>=0.104.0",
    "uvicorn[standard]>=0.24.0",
    "websockets>=12.0",
    # Database and ORM
    "sqlalchemy>=2.0.0",
    "alembic>=1.13.0",
    # Authentication and security
    "python-jose[cryptography]>=3.3.0",
    "passlib[bcrypt]>=1.7.4",
    "python-multipart>=0.0.9",
    # Data processing and ML
    "numpy>=1.26.0",
    "pandas>=2.2.0",
    "scikit-learn>=1.3.0",
    "joblib>=1.3.0",
    "thefuzz>=0.22.1",
    # Image processing and OCR
    "pillow>=10.0.0",
    "pytesseract>=0.3.10",
    "opencv-python>=4.8.0",
    "PyMuPDF>=1.23.0",
    "qrcode>=7.0",
    # External services
    "redis>=5.0.0",
    # Monitoring and observability
    "prometheus-client>=0.19.0",
    "sentry-sdk>=1.40.0",
    "psutil>=5.9.0",
    # Networking and async
    "httpx>=0.27.0",
    # Utilities
    "email-validator>=2.0.0",
    "slowapi>=0.1.8",
    "networkx>=3.0",
    "python-louvain>=0.16"
]

[project.optional-dependencies]
dev = [
    # Testing framework
    "pytest>=8.0.0",
    "pytest-asyncio>=0.23.0",
    "pytest-cov>=4.0.0",
    "pytest-xdist>=3.8.0",
    "pytest-html>=4.1.1",
    "pytest-mock>=3.14.0",
    # Test utilities
    "httpx>=0.27.0",
    "coverage>=7.0.0",
    "hypothesis>=6.0.0",
    # Code quality and formatting
    "black>=24.3.0",
    "isort>=5.12.0",
    "flake8>=7.0.0",
    "mypy>=1.5.0",
    "pre-commit>=3.4.0",
    "tox>=3.28.0",
    # Security scanning
    "bandit>=1.7.0",
    # Documentation
    "mkdocs>=1.5.0",
    "mkdocs-material>=9.0.0",
    # Development tools
    "jupyter>=1.0.0",
    "ipykernel>=6.0.0",
    "notebook>=7.0.0",
    # Database development
    "sqlite-utils>=3.35",
    # API testing
    "requests>=2.31.0",
    # Performance testing
    "locust>=2.15.0",
    # Container development
    "docker-compose>=1.29.0",
    # Environment management
    "python-dotenv>=1.0.0"
]

[tool.setuptools.packages.find]
where = ["."]
include = ["backend*", "core*", "services*", "scripts*"]
exclude = ["tests*", "docs*", "frontend*", "infrastructure*", "monitoring*"]