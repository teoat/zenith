# Simple378 Fraud Detection Platform - Production Environment Configuration
# CRITICAL: Change all default values before production deployment!

# =============================================================================
# CRITICAL SECURITY SETTINGS (CHANGE THESE IMMEDIATELY!)
# =============================================================================

# Database encryption key - Generate with: openssl rand -hex 32
SQLCIPHER_KEY=4f7e8d9c2b5a1e6f3d8c7b9a4e2f1d6c8b5a9e4f2d7c1b6a9e3f8d2c5b7a1e4f9

# Master password - Use a strong password with at least 16 characters
MASTER_PASSWORD=ProductionSecureMasterPass2025!@#$%^&*()

# IPC communication secret - Generate with: openssl rand -hex 32
IPC_SECRET=8e4f2a9c6d1b7e5f3a8d9c2b6e4f1a7d9c3b8e5f2a1d6c9b4e7f3a8d2c5b1e9

# Authentication encryption key - Generate with: openssl rand -hex 32
AUTH_ENCRYPTION_KEY=1f8e4d2c9b6a3f7e5d8c1b9a4f2e6d3c8b5a7e9f4d2c1b6a8e3f5d9c2b7a4e1

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment setting
ENVIRONMENT=production

# Server configuration
HOST=127.0.0.1
PORT=8000
WEBSOCKET_PORT=8080

# Database configuration
DATABASE_URL=sqlite:///data/audit.db

# Vector store configuration
VECTOR_STORE_PATH=data/vector_store.db

# Redis configuration (optional - falls back to memory cache if unavailable)
REDIS_URL=redis://localhost:6379

# =============================================================================
# SECURITY HEADERS & CORS
# =============================================================================

# CORS allowed origins (comma-separated for production domains)
CORS_ORIGINS=https://app.378x492.com,https://api.378x492.com

# Content Security Policy settings
CSP_DEFAULT_SRC=self
CSP_SCRIPT_SRC=self unsafe-inline unsafe-eval
CSP_STYLE_SRC=self unsafe-inline
CSP_IMG_SRC=self data: https:
CSP_FONT_SRC=self
CSP_CONNECT_SRC=self https://api.378x492.com
CSP_FRAME_ANCESTORS=none

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable APM monitoring
ENABLE_APM=true

# Metrics collection interval (seconds)
METRICS_INTERVAL=60

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup directory
BACKUP_DIR=data/backups

# Backup retention period (days)
BACKUP_RETENTION_DAYS=30

# Enable automated backups
ENABLE_AUTO_BACKUP=true

# Backup schedule (cron format: daily at 2 AM)
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# AI/ML CONFIGURATION
# =============================================================================

# Enable AI services
ENABLE_AI=true

# Training data path
TRAINING_DATA_PATH=data/training

# Model update interval (hours)
MODEL_UPDATE_INTERVAL=24

# =============================================================================
# COLLABORATION CONFIGURATION
# =============================================================================

# Maximum concurrent sessions
MAX_SESSIONS=100

# Session timeout (minutes)
SESSION_TIMEOUT=60

# Enable real-time collaboration
ENABLE_COLLABORATION=true

# =============================================================================
# PRODUCTION DEPLOYMENT SETTINGS
# =============================================================================

# Application version
APP_VERSION=1.0.0

# Build number
BUILD_NUMBER=1

# Deployment environment
DEPLOY_ENV=production

# Force HTTPS redirect in production
FORCE_HTTPS=true

# Trusted hosts (comma-separated)
TRUSTED_HOSTS=api.378x492.com,app.378x492.com
