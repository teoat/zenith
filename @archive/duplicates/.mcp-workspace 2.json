{
  "workspace": {
    "name": "378x492-fraud-detection",
    "type": "fullstack-python-react-electron",
    "description": "Desktop fraud detection system with Python backend, React frontend, and Electron wrapper"
  },
  "mcpServers": {
    "github": {
      "enabled": true,
      "priority": "high",
      "config": {
        "owner": "378x492",
        "defaultRepo": "fraud-detection",
        "token": "${GITHUB_TOKEN}"
      }
    },
    "postgres": {
      "enabled": true,
      "priority": "high",
      "config": {
        "connectionString": "${POSTGRES_URL:-postgresql://localhost:5432/fraud_detection}"
      }
    },
    "chrome-devtools": {
      "enabled": true,
      "priority": "medium",
      "config": {
        "headless": false
      }
    },
    "context7": {
      "enabled": true,
      "priority": "medium",
      "libraries": [
        "react",
        "fastapi",
        "postgresql",
        "electron",
        "sqlalchemy",
        "pydantic",
        "typescript",
        "vite"
      ]
    },
    "prometheus": {
      "enabled": true,
      "priority": "medium",
      "config": {
        "url": "${PROMETHEUS_URL:-http://localhost:9090}"
      }
    },
    "memory": {
      "enabled": true,
      "priority": "low"
    },
    "sequential-thinking": {
      "enabled": true,
      "priority": "low"
    }
  },
  "autoLoad": true,
  "fallbackServers": ["memory", "sequential-thinking"],
  "version": "1.0.0"
}
