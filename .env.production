# Production Environment Configuration Template
# WARNING: Never commit actual secrets to version control
# Generate strong random keys for production use

# =============================================
# CRITICAL SECURITY CONFIGURATION
# =============================================

# Main encryption key for sensitive data (REQUIRED)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=9dface0b9b954b1b6f099b93acf1e2b5f843914c3d59fbfa48da8e1bef31f6dc

# Database encryption key for SQLite/SQLCipher (REQUIRED)
# Generate with: openssl rand -hex 32
SQLCIPHER_KEY=6558c2f7ae5ab3675de17823b3503800dc23e1dfd67d347a0c3600e849e36506

# Authentication encryption key (REQUIRED)
# Generate with: openssl rand -hex 32
AUTH_ENCRYPTION_KEY=c9cebba5fb982a1b8929bb7114736604f1a40776bfbb494fb9ca08d2a64cb9fa

# Field-level encryption key (REQUIRED)
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=f3c919eec48683a36b2c05237ebabbd9005b2fa44ec521585c156b534f385a65

# IPC communication secret (REQUIRED)
# Generate with: openssl rand -hex 32
IPC_SECRET=52fe71b85259e26631d4fa842a8bdb7d47e312d88331b8e2564a9d2c213fc649

# JWT secret key (REQUIRED)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=f8bc73ecee9f6391b29f6a882608f8c51b8775fa0fc09583e4190bf669bf66c3

# =============================================
# APPLICATION CONFIGURATION
# =============================================

# Environment
NODE_ENV=production
ENVIRONMENT=production

# Server configuration
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/fraud_detection_prod.db

# =============================================
# SECURITY SETTINGS
# =============================================

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password security
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=3
ACCOUNT_LOCKOUT_MINUTES=30

# =============================================
# MONITORING & LOGGING
# =============================================

# Log level
LOG_LEVEL=WARNING

# Sentry DSN (optional)
SENTRY_DSN=

# Prometheus
PROMETHEUS_PORT=9090

# =============================================
# EXTERNAL SERVICES
# =============================================

# Redis (if used)
REDIS_URL=redis://localhost:6379/0

# Email service (if used)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# =============================================
# BACKUP & RECOVERY
# =============================================

# Backup configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# =============================================
# PERFORMANCE TUNING
# =============================================

# Worker processes
WORKERS=4

# Connection limits
MAX_CONNECTIONS=1000

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=3600