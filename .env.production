# Production Environment Configuration for 378x492 Fraud Detection Platform
# WARNING: Never commit actual secrets to version control

# ========== SECURITY CONFIGURATION ==========
# Database encryption key (generate with: openssl rand -hex 32)
SQLCIPHER_KEY=your-production-sqlcipher-key-here-64-chars-minimum

# IPC shared secret for inter-process communication
IPC_SECRET=your-production-ipc-secret-here-64-chars-minimum

# Authentication encryption key
AUTH_ENCRYPTION_KEY=your-production-auth-encryption-key-here-64-chars-minimum

# ========== APPLICATION CONFIGURATION ==========
# Environment
NODE_ENV=production
PYTHON_ENV=production

# Server configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# CORS configuration for production
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ========== DATABASE CONFIGURATION ==========
# Use PostgreSQL for production (recommended)
DATABASE_URL=postgresql://fraud_user:your_secure_password_here@localhost:5432/fraud_detection_prod

# Alternative: Keep SQLite for small deployments (not recommended for production)
# DATABASE_URL=sqlite:///./fraud_detection_prod.db

# ========== EXTERNAL SERVICES ==========
# Redis for caching and sessions (recommended for production)
REDIS_URL=redis://localhost:6379/0

# Monitoring and logging
SENTRY_DSN=your-sentry-dsn-here
LOG_LEVEL=WARNING

# ========== FEATURE FLAGS ==========
# Enable production features
ENABLE_METRICS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=true
ENABLE_ENCRYPTION=true

# Disable development features
DEBUG=false
ENABLE_SWAGGER=false

# ========== BACKUP CONFIGURATION ==========
# Automated backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key-here

# ========== COMPLIANCE SETTINGS ==========
# Data retention policies (days)
AUDIT_LOG_RETENTION=2555  # 7 years for compliance
CASE_DATA_RETENTION=2555
TRANSACTION_DATA_RETENTION=2555

# Regulatory compliance
GDPR_COMPLIANT=true
SOX_COMPLIANT=true
PCI_COMPLIANT=true

# ========== PERFORMANCE TUNING ==========
# Connection pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
REDIS_POOL_SIZE=20

# Caching settings
CACHE_TTL_SECONDS=3600
SESSION_TTL_SECONDS=86400

# ========== MONITORING ==========
# Health check endpoints
HEALTH_CHECK_ENABLED=true
METRICS_ENDPOINT_ENABLED=true

# Alert thresholds
CPU_THRESHOLD=80
MEMORY_THRESHOLD=85
DISK_THRESHOLD=90