# Production Environment Configuration
# CRITICAL: Keep this file secure and NEVER commit to git
# Generated: 2025-12-17 05:00:00 JST

# ====================
# SECURITY & ENCRYPTION
# ====================
ENCRYPTION_KEY=__REPLACE_WITH_GENERATED_KEY_1__
SQLCIPHER_KEY=__REPLACE_WITH_GENERATED_KEY_2__
IPC_SECRET=__REPLACE_WITH_GENERATED_KEY_3__
AUTH_ENCRYPTION_KEY=__REPLACE_WITH_GENERATED_KEY_4__
JWT_SECRET_KEY=__REPLACE_WITH_GENERATED_KEY_5__
SESSION_SECRET=__REPLACE_WITH_GENERATED_KEY_6__

# ====================
# DATABASE
# ====================
DATABASE_URL=postgresql://user:password@localhost:5432/fraud_detection
# For SQLCipher encrypted database:
# DATABASE_URL=sqlite+pysqlcipher:///:memory:?cipher=aes-256-cbc&kdf_iter=64000

# ====================
# REDIS CACHE
# ====================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=__REPLACE_WITH_REDIS_PASSWORD__

# ====================
# JWT CONFIGURATION
# ====================
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ====================
# APPLICATION
# ====================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ====================
# EXTERNAL SERVICES
# ====================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
PROMETHEUS_PORT=9090

# ====================
# EMAIL (if using email features)
# ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@your-domain.com

# ====================
# FRAUD DETECTION
# ====================
FRAUD_DETECTION_THRESHOLD=0.75
MAX_TRANSACTION_AMOUNT=1000000
ANOMALY_DETECTION_ENABLED=true

# ====================
# FILE UPLOAD
# ====================
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,csv,xlsx,txt

# ====================
# RATE LIMITING
# ====================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ====================
# BACKUP & RECOVERY
# ====================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
