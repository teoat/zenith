# Production Environment Configuration Template
# WARNING: Never commit actual secrets to version control
# Generate strong random keys for production use

# =============================================
# CRITICAL SECURITY CONFIGURATION
# =============================================

# Main encryption key for sensitive data (REQUIRED)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=PRODUCTION_ENCRYPTION_KEY_REPLACE_WITH_STRONG_RANDOM_64_CHAR_HEX

# Database encryption key for SQLite/SQLCipher (REQUIRED)
# Generate with: openssl rand -hex 32
SQLCIPHER_KEY=PRODUCTION_SQLCIPHER_KEY_REPLACE_WITH_STRONG_RANDOM_64_CHAR_HEX

# Authentication encryption key (REQUIRED)
# Generate with: openssl rand -hex 32
AUTH_ENCRYPTION_KEY=PRODUCTION_AUTH_ENCRYPTION_KEY_REPLACE_WITH_STRONG_RANDOM_64_CHAR_HEX

# Field-level encryption key (REQUIRED)
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=PRODUCTION_FIELD_ENCRYPTION_KEY_REPLACE_WITH_STRONG_RANDOM_64_CHAR_HEX

# IPC communication secret (REQUIRED)
# Generate with: openssl rand -hex 32
IPC_SECRET=PRODUCTION_IPC_SECRET_REPLACE_WITH_STRONG_RANDOM_64_CHAR_HEX

# JWT secret key (REQUIRED)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=PRODUCTION_JWT_SECRET_KEY_REPLACE_WITH_STRONG_RANDOM_64_CHAR_HEX

# =============================================
# APPLICATION CONFIGURATION
# =============================================

# Environment
NODE_ENV=production
ENVIRONMENT=production

# Server configuration
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/fraud_detection_prod.db

# =============================================
# SECURITY SETTINGS
# =============================================

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password security
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=3
ACCOUNT_LOCKOUT_MINUTES=30

# =============================================
# MONITORING & LOGGING
# =============================================

# Log level
LOG_LEVEL=WARNING

# Sentry DSN (optional)
SENTRY_DSN=

# Prometheus
PROMETHEUS_PORT=9090

# =============================================
# EXTERNAL SERVICES
# =============================================

# Redis (if used)
REDIS_URL=redis://localhost:6379/0

# Email service (if used)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# =============================================
# BACKUP & RECOVERY
# =============================================

# Backup configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# =============================================
# PERFORMANCE TUNING
# =============================================

# Worker processes
WORKERS=4

# Connection limits
MAX_CONNECTIONS=1000

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=3600