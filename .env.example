# Development environment example
# Copy this to .env and update values for local development/testing.

# Database encryption key (hex, 64 chars recommended)
SQLCIPHER_KEY=REPLACE_WITH_RANDOM_HEX_64

# Optional master password for automated runs (not recommended for production)
MASTER_PASSWORD=your_secure_master_password_here

# IPC shared secret (hex)
IPC_SECRET=REPLACE_WITH_RANDOM_HEX_64

# Key used to encrypt auth.dat (hex)
AUTH_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_HEX_64

# App environment
NODE_ENV=development

# Example: override host/port for backend
HOST=localhost
PORT=8000

# Backend specific environment variables
# REQUIRED: This key is used for encrypting sensitive data at rest.
# The application will not start without this key being set.
# Generate a new key with: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_A_SECURE_RANDOM_KEY
